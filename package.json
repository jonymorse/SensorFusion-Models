{
  "name": "thermal-forgecad-modelling",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "check:coupon": "forgecad.cmd run cad/tests/snap_fit_test_coupon.forge.js",
    "check:insert-coupon": "forgecad.cmd run cad/tests/heat_set_insert_coupon.forge.js",
    "check:thermal": "forgecad.cmd run cad/calibration/thermal_calibration_target.forge.js",
    "check:realsense": "forgecad.cmd run cad/sensor_fusion/realsense_mount_plate.forge.js",
    "check:sensor-fusion": "forgecad.cmd run cad/sensor_fusion/sensor_fusion_mount.forge.js",
    "check:gopro-stand": "forgecad.cmd run cad/sensor_fusion/gopro_camera_stand.forge.js",
    "check:realsense:rugged": "forgecad.cmd run cad/concepts/realsense_mount_plate_rugged_concept.forge.js",
    "preview:coupon": "forgecad.cmd render 3d cad/tests/snap_fit_test_coupon.forge.js --output outputs/previews/snap-fit-test-coupon-preview.png --chrome-path \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "preview:thermal": "forgecad.cmd render 3d cad/calibration/thermal_calibration_target.forge.js --output outputs/previews/thermal-calibration-target-preview.png --chrome-path \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "preview:realsense": "forgecad.cmd render 3d cad/sensor_fusion/realsense_mount_plate.forge.js --output outputs/previews/realsense-mount-plate-preview.png --chrome-path \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "preview:sensor-fusion": "forgecad.cmd render 3d cad/sensor_fusion/sensor_fusion_mount.forge.js --output outputs/previews/sensor-fusion-mount-preview.png --chrome-path \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "preview:realsense:rugged": "forgecad.cmd render 3d cad/concepts/realsense_mount_plate_rugged_concept.forge.js --output outputs/previews/realsense-rugged-concept-preview.png --chrome-path \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "export:thermal:step": "forgecad.cmd export step cad/calibration/thermal_calibration_target.forge.js --output outputs/exports/thermal_calibration_target.step",
    "export:realsense:step": "forgecad.cmd export step cad/sensor_fusion/realsense_mount_plate.forge.js --output outputs/exports/realsense_mount_plate.step",
    "export:sensor-fusion:step": "forgecad.cmd export step cad/sensor_fusion/sensor_fusion_mount.forge.js --output outputs/exports/sensor_fusion_mount.step",
    "export:realsense:rugged:step": "forgecad.cmd export step cad/concepts/realsense_mount_plate_rugged_concept.forge.js --output outputs/exports/realsense_mount_plate_rugged_concept.step",
    "studio": "forgecad.cmd studio .",
    "save:snap:candidate": "node scripts/save_snap_profile.js --profile candidate",
    "promote:snap:candidate": "node scripts/promote_snap_snapshot.js --profile candidate",
    "watch:snap:candidate": "node scripts/watch_snap_snapshot.js --profile candidate",
    "watch:snap:start": "node scripts/start_snap_snapshot_watcher.js",
    "watch:snap:stop": "node scripts/stop_snap_snapshot_watcher.js"
  }
}
