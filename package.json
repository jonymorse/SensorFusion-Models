{
  "name": "thermal-forgecad-modelling",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "check:coupon": "forgecad.cmd run models/snap_fit_test_coupon.forge.js",
    "check:thermal": "forgecad.cmd run models/thermal_calibration_target.forge.js",
    "check:realsense": "forgecad.cmd run models/realsense_mount_plate.forge.js",
    "preview:coupon": "forgecad.cmd render 3d models/snap_fit_test_coupon.forge.js --output outputs/snap-fit-test-coupon-preview.png --chrome-path \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "preview:thermal": "forgecad.cmd render 3d models/thermal_calibration_target.forge.js --output outputs/thermal-calibration-target-preview.png --chrome-path \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "preview:realsense": "forgecad.cmd render 3d models/realsense_mount_plate.forge.js --output outputs/realsense-mount-plate-preview.png --chrome-path \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "export:thermal:step": "forgecad.cmd export step models/thermal_calibration_target.forge.js --output outputs/thermal_calibration_target.step",
    "export:realsense:step": "forgecad.cmd export step models/realsense_mount_plate.forge.js --output outputs/realsense_mount_plate.step",
    "studio": "forgecad.cmd studio .",
    "save:snap:candidate": "node scripts/save_snap_profile.js --profile candidate",
    "promote:snap:candidate": "node scripts/promote_snap_snapshot.js --profile candidate",
    "watch:snap:candidate": "node scripts/watch_snap_snapshot.js --profile candidate",
    "watch:snap:start": "node scripts/start_snap_snapshot_watcher.js",
    "watch:snap:stop": "node scripts/stop_snap_snapshot_watcher.js"
  }
}
